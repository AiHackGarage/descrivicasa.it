# DescriviCasa.it - Variabili d'ambiente
# Copia questo file in .env e compila i valori

# Database MySQL
DB_HOST=127.0.0.1
DB_USER=descrivicasa
DB_PASS=la_tua_password
DB_NAME=descrivicasa

# JWT (generane uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=genera_un_secret_lungo_e_casuale

# OpenRouter API
OPENROUTER_API_KEY=sk-or-v1-...

# Opzionali
PORT=8000
VISION_MODEL=google/gemini-2.5-flash
CHAT_MODEL=deepseek/deepseek-chat
UPLOAD_DIR=../persistent_uploads
